<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- mDNS/Bonjour discovery of the Race Navigator and raw TCP/FTP/PostgreSQL access in the local WiFi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Health Connect: read heart rate -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <application>
        <!-- Share sheet: staged files leave the app through the FileProvider the Capacitor app template already declares
             (${applicationId}.fileprovider, cache-path "."); a second provider of the same class would fail the manifest merge -->
        <!-- Health Connect shows the app's privacy rationale through these intents (Android 13 and 14+) -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="${applicationId}.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>

{
  "name": "rn-analyzer",
  "version": "2.1.3",
  "description": "RN Analyzer 2.0 - Race Navigator lap analysis (web app + Capacitor iOS/Android shells)",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs 8080",
    "mock-device": "node tools/mock-device-server.mjs 8090 \"Example files\"",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "test": "node --test tools/test/unit.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "rn-device": "file:native/rn-device",
    "@capacitor/android": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
